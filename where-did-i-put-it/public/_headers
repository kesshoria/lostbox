# Security headers for Cloudflare Pages.
# Read automatically when deploying via Cloudflare Pages (Direct Upload
# or Git integration).
#
# Syntax: a path pattern, followed by indented `Header-Name: value` lines.
# All headers below apply to "/*" (every file).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
